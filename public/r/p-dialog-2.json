{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "p-dialog-2",
  "description": "Dialog — From Menu",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "https://taut-ui.com/r/button.json",
    "https://taut-ui.com/r/dialog.json",
    "https://taut-ui.com/r/menu.json"
  ],
  "files": [
    {
      "path": "src/registry/default/particles/p-dialog-2.tsx",
      "content": "\"use client\";\n\nimport { MoreHorizontalIcon, Trash2Icon, UserPlusIcon } from \"lucide-react\";\nimport { useState } from \"react\";\nimport { Button } from \"@/registry/default/ui/button\";\nimport {\n  Dialog,\n  DialogClose,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogPopup,\n  DialogTitle,\n} from \"@/registry/default/ui/dialog\";\nimport {\n  Menu,\n  MenuItem,\n  MenuPopup,\n  MenuSeparator,\n  MenuTrigger,\n} from \"@/registry/default/ui/menu\";\n\nexport default function Particle() {\n  const [open, setOpen] = useState(false);\n\n  return (\n    <div className=\"flex items-center justify-center\">\n      <Menu>\n        <MenuTrigger\n          render={\n            <Button size=\"icon-sm\" variant=\"outline\">\n              <MoreHorizontalIcon />\n            </Button>\n          }\n        />\n        <MenuPopup align=\"center\">\n          <MenuItem>\n            <UserPlusIcon className=\"size-4\" />\n            <span>Invite members</span>\n          </MenuItem>\n          <MenuSeparator />\n          <MenuItem onClick={() => setOpen(true)} variant=\"destructive\">\n            <Trash2Icon className=\"size-4\" />\n            <span>Delete project</span>\n          </MenuItem>\n        </MenuPopup>\n      </Menu>\n\n      <Dialog onOpenChange={setOpen} open={open}>\n        <DialogPopup className=\"sm:max-w-md\" showCloseButton>\n          <DialogHeader>\n            <DialogTitle>Delete project</DialogTitle>\n            <DialogDescription>\n              Are you sure you want to delete this project? All associated data,\n              repositories, and deployments will be permanently removed.\n            </DialogDescription>\n          </DialogHeader>\n          <DialogFooter>\n            <DialogClose render={<Button variant=\"ghost\" />}>\n              Cancel\n            </DialogClose>\n            <Button onClick={() => setOpen(false)} variant=\"destructive\">\n              Delete permanently\n            </Button>\n          </DialogFooter>\n        </DialogPopup>\n      </Dialog>\n    </div>\n  );\n}\n",
      "type": "registry:example"
    }
  ],
  "categories": [
    "button",
    "dialog",
    "menu"
  ],
  "type": "registry:example"
}